# Copy these values into the separate Render staging service only.
# Never reuse the production Render environment group.
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
SITE_URL=https://your-surplus-staging-service.onrender.com
FOUNDING_BETA_CHECKOUT_ENABLED=true

# Separate Supabase test project. The helper requires both refs and rejects a match.
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_test_project_server_only_key
EXPECTED_STAGING_SUPABASE_PROJECT_REF=your-test-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref

# Stripe test mode only. Both IDs must belong to the same test-mode account.
STRIPE_SECRET_KEY=sk_test_server_only_key
STRIPE_WEBHOOK_SECRET=whsec_staging_endpoint_secret
STRIPE_FOUNDING_PRICE_ID=price_test_30_usd_monthly
STRIPE_REGULAR_PRICE_ID=price_test_regular_monthly

# Use a staging-only Resend key/sender and the one inbox used for the test.
RESEND_API_KEY=re_staging_only_key
WAITLIST_FROM_EMAIL="Surplus Staging <onboarding@resend.dev>"
STAGING_TEST_EMAIL=your-resend-account-email@example.com

# Intentionally omit every DISCORD_* variable in staging.
# ADMIN_EMAILS may contain only the staging test email if owner checks are needed.
ADMIN_EMAILS=
